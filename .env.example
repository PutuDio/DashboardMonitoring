APP_NAME="Monitoring System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=monitoring_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Monitoring Worker Settings
MONITOR_RESPONSE_THRESHOLD=3000
MONITOR_CHECK_SSL=true
MONITOR_CHECK_CONTENT=true
MONITOR_TIMEOUT=30
MONITOR_SSL_WARNING_DAYS=30
MONITOR_LOG_RETENTION_DAYS=30
